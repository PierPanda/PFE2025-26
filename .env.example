# Database
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:5173

# Bookings cron
# En local : http://host.docker.internal:5173/api/bookings/complete
# En prod  : URL interne du service app (ex. http://app:3000/api/bookings/complete)
BOOKINGS_COMPLETE_ENDPOINT=http://host.docker.internal:5173/api/bookings/complete
BOOKINGS_COMPLETE_CRON_SECRET=your-cron-secret-here

# Cloudflare R2
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=maestroo
R2_PUBLIC_URL=https://cdn.yourdomain.com
